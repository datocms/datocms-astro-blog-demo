{
  "name": "Astro Blog",
  "description": "Simple blog website built Astro and DatoCMS, with no client-side javascript, and preview mode",
  "previewImage": "https://www.datocms-assets.com/73607/1655209586-screenshot-2022-06-14-at-14-25-56.png?crop=top&fit=crop&h=500&w=600&auto=format",
  "datocmsProjectId": "73607",
  "deploymentType": "static",
  "buildCommand": "npm run build",
  "livePreviewUrl": "https://blog-astro-no-clientside-js.vercel.app/",
  "environmentVariables": {
    "DATOCMS_PUBLISHED_CONTENT_CDA_TOKEN": {
      "type": "datocmsAccessToken",
      "tokenName": "CDA Only (Published)"
    },
    "DATOCMS_DRAFT_CONTENT_CDA_TOKEN": {
      "type": "datocmsAccessToken",
      "tokenName": "CDA Only (Draft)"
    }
  }
}
